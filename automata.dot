digraph AFD {
  rankdir=LR;
  size="15,10";
  node [shape = doublecircle, style=filled, fillcolor=lightblue]; 
  S1 S2 S4 S6 S8 S10 S13 S14 S16; // Estados de aceptación
  node [shape = circle, style=solid, fillcolor=white]; 
  
  // 1. Identificadores, Reservadas y Comandos
  S0 -> S1 [label=" letra | _ "];
  S1 -> S1 [label=" letra | dígito | _ "];
  
  // 2. Números (Enteros y Decimales)
  S0 -> S2 [label=" dígito "];
  S2 -> S2 [label=" dígito "];
  S2 -> S3 [label=" . "];
  S3 -> S4 [label=" dígito "];
  S4 -> S4 [label=" dígito "];
  
  // 3. Directivas (@modelo, @rol)
  S0 -> S5 [label=" @ "];
  S5 -> S6 [label=" letra "];
  S6 -> S6 [label=" letra | dígito | _ "];
  
  // 4. Literales de Cadena
  S0 -> S7 [label=" \" "];
  S7 -> S7 [label=" cualquier carácter excepto \n y \" "];
  S7 -> S8 [label=" \" "];
  
  // 5. Conector Flecha (->)
  S0 -> S15 [label=" - "];
  S15 -> S16 [label=" > "];
  
  // 6. Delimitadores y Operadores de un solo carácter
  S0 -> S14 [label=" { | } | ( | ) | , | = | + "];
  
  // 7. Comentarios de Línea y Bloque
  S0 -> S9 [label=" / "];
  S9 -> S10 [label=" / (Línea) "];
  S9 -> S11 [label=" * (Bloque) "];
  S11 -> S11 [label=" distinto de * "];
  S11 -> S12 [label=" * "];
  S12 -> S11 [label=" distinto de / "];
  S12 -> S13 [label=" / "];
}